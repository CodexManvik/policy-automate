# ===========================================================================
# LLM / Semantic Agent Config
# ===========================================================================
# LLM backend: local | openai | mock
LLM_PROVIDER=local
LLM_URL=http://127.0.0.1:8080

# OpenAI API key
OPENAI_API_KEY=sk-proj-
# Keep true so the backend drops the GBNF grammar constraints, allowing 
# Gemma 4 to output its thinking track before generating structural JSON.
REASONING_ON=true

# ===========================================================================
# Four-Tier Adjudication Confidence Thresholds
# ===========================================================================
# Confidence >= 0.90 -> Auto Adjudication (APPROVED / PARTIALLY_APPROVED / REJECTED)
CONFIDENCE_THRESHOLD=0.90
AUTO_APPROVE_THRESHOLD=0.90

# Confidence in [0.70, 0.90) -> ASSISTED_REVIEW (Ops review queue)
ASSISTED_REVIEW_THRESHOLD=0.70

# Confidence in [0.50, 0.70) -> MEDICAL_REVIEW (Clinical/expert queue)
# Confidence < 0.50          -> PENDING_REVIEW (Senior auditor queue)
MEDICAL_REVIEW_THRESHOLD=0.50

# ===========================================================================
# API Server Configuration
# ===========================================================================
# Normalized to standard comma-separated format to ensure clean parsing
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# ===========================================================================
# Telemetry
# ===========================================================================
TELEMETRY_FILE=logs/metrics_telemetry.jsonl

# ===========================================================================
# PostgreSQL Persistence (async via asyncpg + SQLAlchemy 2.0)
# ===========================================================================
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
# Leave blank to use in-memory seed data (no Postgres required).
DATABASE_URL=postgresql+asyncpg://nivabupa:nivabupa_dev_secret@localhost:5432/adjudication

# Docker Compose Postgres credentials (must match DATABASE_URL above)
POSTGRES_USER=nivabupa
POSTGRES_PASSWORD=nivabupa_dev_secret
POSTGRES_DB=adjudication
POSTGRES_PORT=5432

# pgAdmin (optional UI, accessible at http://localhost:5050)
PGADMIN_EMAIL=admin@nivabupa.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050