# ===========================================================================
# LLM / Semantic Agent Config
# ===========================================================================
# LLM backend: groq | local | mock
#   groq  - Groq cloud API (needs GROQ_API_KEY)
#   local - llama.cpp server at LLM_URL
#   mock  - deterministic offline answers (demos without internet, tests)
LLM_PROVIDER=groq
LLM_URL=http://127.0.0.1:8080

# Groq API key (https://console.groq.com/keys) and model
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Keep true so the backend drops the GBNF grammar constraints, allowing 
# Gemma 4 to output its thinking track before generating structural JSON.
REASONING_ON=true

# ===========================================================================
# Four-Tier Adjudication Confidence Thresholds
# ===========================================================================
# Confidence >= 0.90 -> Auto Adjudication (APPROVED / PARTIALLY_APPROVED / REJECTED)
CONFIDENCE_THRESHOLD=0.90
AUTO_APPROVE_THRESHOLD=0.90

# Confidence in [0.70, 0.90) -> ASSISTED_REVIEW (Ops review queue)
ASSISTED_REVIEW_THRESHOLD=0.70

# Confidence in [0.50, 0.70) -> MEDICAL_REVIEW (Clinical/expert queue)
# Confidence < 0.50          -> PENDING_REVIEW (Senior auditor queue)
MEDICAL_REVIEW_THRESHOLD=0.50

# ===========================================================================
# API Server Configuration
# ===========================================================================
# Normalized to standard comma-separated format to ensure clean parsing
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# ===========================================================================
# Telemetry
# ===========================================================================
TELEMETRY_FILE=metrics_telemetry.jsonl