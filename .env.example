# ReAssure 3.0 — Environment Variable Reference
# Copy this file to .env and fill in values for your environment.
# The application loads .env automatically via pydantic-settings.

# ---------------------------------------------------------------------------
# LLM / Semantic Agent
# ---------------------------------------------------------------------------

# LLM backend: mock | local | openai
# 'mock'  — deterministic rule-based responses; safe for unit testing and CI
# 'local' — connects to a llama.cpp server at LLM_URL
# 'openai'— uses OpenAI chat completions API; requires OPENAI_API_KEY
LLM_PROVIDER=mock

# Base URL of the local llama.cpp inference server
LLM_URL=http://127.0.0.1:8080

# OpenAI API key — required only when LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Enable chain-of-thought reasoning in local LLM completions (true/false)
REASONING_ON=true

# ---------------------------------------------------------------------------
# Adjudication Thresholds
# ---------------------------------------------------------------------------

# Confidence >= AUTO_APPROVE_THRESHOLD → claim auto-approved
AUTO_APPROVE_THRESHOLD=0.90

# Confidence in [ASSISTED_REVIEW_THRESHOLD, AUTO_APPROVE_THRESHOLD) → ASSISTED_REVIEW
ASSISTED_REVIEW_THRESHOLD=0.70

# ---------------------------------------------------------------------------
# API Server
# ---------------------------------------------------------------------------

# Comma-separated list of allowed CORS origins
# For local development: http://localhost:5173,http://127.0.0.1:5173
# For production: set to your frontend domain, e.g. https://claims.example.com
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------

# Path to the JSONL telemetry log file (relative to working directory)
TELEMETRY_FILE=metrics_telemetry.jsonl
